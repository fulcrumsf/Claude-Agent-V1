+                pic = imaging.decode_png(data)
+                if (pic.width, pic.height) != (w, h):
+                    return None
+                res = rgb(pic.data)
+                lr = box(res @ lum_w, 3)
+                cr = res / (res.sum(2, keepdims=True) + 1.0)
+                diff = box(np.abs(res - base).max(axis=2), 2)
+                same_hue = box(np.abs(cr - cb).max(axis=2), 2) < 0.045
