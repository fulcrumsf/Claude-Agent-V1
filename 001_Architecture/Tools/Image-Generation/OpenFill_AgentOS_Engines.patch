+def build_flux2_klein_edit(
+    req: InpaintRequest,
+    image_ref: str,
+    mask_ref: str,
+    seed: int,
+    caps: Capabilities,
+    filename_prefix: str = "openfill/klein",
+) -> dict:
+    """Agent-OS patch: FLUX.2 klein 4B (Apache-2.0) edit of the context region: the context is the
+    reference latent and the start latent, limited to the mask with a latent noise mask."""
+    g = Graph()
+    spec = req.model
+    g.add("unet", "UNETLoader", unet_name=spec.unet, weight_dtype="default")
+    g.add("clip", "CLIPLoader", clip_name=spec.clip1, type="flux2")
+    g.add("vae", "VAELoader", vae_name=spec.vae)
+    vae = g.out("vae")
+    image, mask = _load_inputs(g, req, image_ref, mask_ref, caps)
+    g.add("encode", "VAEEncode", pixels=image, vae=vae)
+    g.add("pos", "CLIPTextEncode", clip=g.out("clip"), text=req.prompt or "")
+    g.add("ref", "ReferenceLatent", conditioning=g.out("pos"), latent=g.out("encode"))
+    g.add("guider", "BasicGuider", model=g.out("unet"), conditioning=g.out("ref"))
+    g.add("sigmas", "Flux2Scheduler", steps=int(req.sampling.steps), width=int(req.work_width), height=int(req.work_height))
+    g.add("sampler_select", "KSamplerSelect", sampler_name="euler")
+    g.add("noise", "RandomNoise", noise_seed=int(seed))
+    g.add("noise_mask", "SetLatentNoiseMask", samples=g.out("encode"), mask=mask)
+    latent = g.out("noise_mask")
+    batch = max(1, int(req.sampling.batch))
+    if batch > 1:
+        g.add("batch", "RepeatLatentBatch", samples=latent, amount=batch)
+        latent = g.out("batch")
+    g.add("sampler", "SamplerCustomAdvanced", noise=g.out("noise"), guider=g.out("guider"),
+          sampler=g.out("sampler_select"), sigmas=g.out("sigmas"), latent_image=latent)
+    g.add("decode", "VAEDecode", samples=g.out("sampler", 0), vae=vae)
     return _finish(g, req, g.out("decode"), mask, caps, filename_prefix)
 
 
