+            f'--{boundary}\r\nContent-Disposition: form-data; name="uploadPath"\r\n\r\nopenfill\r\n'.encode(),
+            f'--{boundary}\r\nContent-Disposition: form-data; name="fileName"\r\n\r\n{uuid.uuid4().hex}_{name}\r\n'.encode(),
+            f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{name}"\r\n'
+            "Content-Type: image/png\r\n\r\n".encode() + png + b"\r\n",
+            f"--{boundary}--\r\n".encode(),
+        ]
+        data = self._post_abs(KIE_UPLOAD, b"".join(parts), f"multipart/form-data; boundary={boundary}")
+        url = (data.get("data") or {}).get("downloadUrl") if isinstance(data, dict) else None
+        if not url:
