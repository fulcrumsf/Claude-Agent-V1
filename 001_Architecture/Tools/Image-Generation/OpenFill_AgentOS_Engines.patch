+    def _post_abs(self, url: str, body: bytes, content_type: str) -> Any:
+        """POST to a full https address of the same provider (kie's upload host), key in the header."""
+        if self._cancelled.is_set():
+            raise GenerationCancelled("cancelled before the request was sent")
+        timeout = 120.0 if not self._deadline else min(120.0, max(0.1, self._deadline - time.monotonic()))
+        req = Request(url, data=body, method="POST", headers=self._headers(content_type))
+        try:
+            with build_opener(_NoRedirect).open(req, timeout=timeout) as resp:
+                return json.loads(_read_capped(resp, self.where).decode("utf-8") or "{}")
+        except HTTPError as err:
+            detail = err.read()[:2000].decode("utf-8", "replace")
