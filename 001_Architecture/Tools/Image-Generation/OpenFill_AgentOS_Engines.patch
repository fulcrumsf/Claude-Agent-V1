+    def _agentos_light(self, image, full, target):
+        """Agent-OS patch: where shadows fall. The brightest large area of the picture (a window or a
+        sunlit patch) is taken as the light; shadows point from it through the selection. Returns
+        (dx, dy, contrast) with a unit direction, or None for an evenly lit picture."""
+        try:
+            import numpy as np
+
+            _png, rgba = self.io.export_region(image, full)
+            a = np.frombuffer(rgba, np.uint8).reshape(full.height, full.width, 4)[..., :3].astype(np.float32)
+            lum = a @ np.float32([0.299, 0.587, 0.114])
+            f = 16
+            hh, ww = lum.shape[0] // f, lum.shape[1] // f
+            small = lum[: hh * f, : ww * f].reshape(hh, f, ww, f).mean((1, 3))
+            top = small >= np.percentile(small, 97)
+            contrast = float(small[top].mean() / max(1.0, np.median(small)))
+            ys, xs = np.nonzero(top)
+            lx, ly = (xs.mean() + 0.5) * f, (ys.mean() + 0.5) * f
+            cx, cy = target.x + target.width / 2, target.y + target.height / 2
+            dx, dy = cx - lx, cy - ly
+            norm = (dx * dx + dy * dy) ** 0.5
+            self.log.info("fill: light at (%d, %d), contrast %.2f, shadow direction (%.2f, %.2f)", lx, ly, contrast,
+                          dx / max(norm, 1e-6), dy / max(norm, 1e-6))
+            if contrast < 1.3 or norm < 1:
+                return None
+            return dx / norm, dy / norm, contrast
+        except Exception as err:  # noqa: BLE001 - no shadow room then, the fill still works
+            self.log.warning("fill: light direction not found (%s)", err)
+            return None
 
+    def _agentos_shadow_zone(self, mask_raw, ctx, shadow_dir):
+        """Agent-OS patch: the selection swept along the shadow direction (the new shadow's room) as the
+        model mask, plus a prompt hint naming the direction."""
+        try:
+            import numpy as np
+
+            from . import imaging
+
+            w, h = ctx.width, ctx.height
+            ux, uy, reach, _contrast = shadow_dir
+            sel = np.frombuffer(mask_raw, np.uint8).reshape(h, w) > 127
+            zone = sel.copy()
+            for i in range(1, 13):
+                d = reach * i / 12
+                dx, dy = int(round(ux * d)), int(round(uy * d))
+                out = np.zeros_like(sel)
+                ys, yd = (slice(0, h - dy), slice(dy, h)) if dy >= 0 else (slice(-dy, h), slice(0, h + dy))
+                xs, xd = (slice(0, w - dx), slice(dx, w)) if dx >= 0 else (slice(-dx, w), slice(0, w + dx))
+                out[yd, xd] = sel[ys, xs]
+                zone |= out
+            words = []
+            if abs(ux) > 0.35:
+                words.append("left" if ux < 0 else "right")
+            if abs(uy) > 0.35:
+                words.append("down" if uy > 0 else "up")
+            hint = (f". It casts a natural shadow toward the {' and '.join(words)}, matching the light and the "
+                    "other shadows in the room; no leftover shadow of anything that was there before")
+            self.log.info("fill: shadow room %d px toward (%.2f, %.2f): model mask %d px (selection %d px)", reach,
+                          ux, uy, int(zone.sum()), int(sel.sum()))
+            return {"model_png": imaging.encode(w, h, (zone.astype(np.uint8) * 255).tobytes(), 1), "zone": zone,
+                    "hint": hint}
+        except Exception as err:  # noqa: BLE001
+            self.log.warning("fill: shadow room not made (%s)", err)
+            return None
